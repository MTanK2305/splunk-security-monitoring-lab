index=sysmon
| eval MITRE_Technique=case(EventCode=1,"T1059 - Command and Scripting Interpreter",EventCode=3,"T1049 - Network Service Discovery",EventCode=11,"T1105 - Ingress Tool Transfer",EventCode=12 OR EventCode=13,"T1112 - Modify Registry",EventCode=22,"T1071.004 - DNS",true(),"Other")
| table _time EventCode MITRE_Technique Image
